# Base URL da API do backend (opcional — por omissão usa "/api" através do proxy do Vite)
VITE_API_URL=/api

# Chave publicável do Stripe (Dashboard → Developers → API keys → Publishable key).
# Sem esta variável, o pagamento por cartão nas Propinas fica automaticamente desativado
# e é mostrada apenas a opção de referência Multibanco.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
